# Public site URL (used for canonical links, sitemap, WhatsApp product links)
NEXT_PUBLIC_SITE_URL=https://www.anangajewels.com

# Sanity CMS — leave the project ID empty to run on the bundled catalogue in src/data
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token, only needed for scripts/import-to-sanity.ts (never expose to the browser)
SANITY_API_WRITE_TOKEN=
# Shared secret for the Sanity → /api/revalidate webhook
SANITY_REVALIDATE_SECRET=

# Contact form (https://resend.com — verify the anangajewels.com domain there)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@anangajewels.com
CONTACT_FROM_EMAIL=Ananga Jewels website <website@anangajewels.com>

# Google Analytics
NEXT_PUBLIC_GA_ID=G-12183NR13G
